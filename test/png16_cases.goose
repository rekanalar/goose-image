// Cases made by test/make_png16_cases.py with Pillow 12.3.0.
// Do not edit by hand. Make the file again with the script.

namespace png16_cases;

import std;
import image from "..";

fn hexval(c: u8) -> i64 {
    if c >= 97 { return c - 87; }
    return c - 48;
}

fn bytes_of(s: u8[:]) -> u8[] {
    var px: u8[>..] = [];
    var i = 0;
    while i + 1 < s.len {
        px.push((hexval(s[i]) * 16 + hexval(s[i + 1])) as u8);
        i += 2;
    }
    return px[..];
}

fn words_of(s: u8[:]) -> u16[] {
    var px: u16[>..] = [];
    var i = 0;
    while i + 3 < s.len {
        px.push((hexval(s[i]) * 4096 + hexval(s[i + 1]) * 256 + hexval(s[i + 2]) * 16 + hexval(s[i + 3])) as u16);
        i += 4;
    }
    return px[..];
}

// read16 checks the decode of a PNG against the pixels of the oracle.
fn read16(png: u8[:], w: i32, h: i32, want: u8[:]) {
    let img = image::decode16(bytes_of(png));
    assert(img.width == w && img.height == h);
    assert(img.pixels == words_of(want));
}

