// Cases made by test/make_jpeg_cases.py with Pillow 12.3.0.
// Do not edit by hand. Make the file again with the script.

namespace jpeg_cases;

import std;
import os;
import image from "..";

fn hexval(c: u8) -> i64 {
    if c >= 97 { return c - 87; }
    return c - 48;
}

fn bytes_of(s: u8[:]) -> u8[] {
    var px: u8[>..] = [];
    var i = 0;
    while i + 1 < s.len {
        px.push((hexval(s[i]) * 16 + hexval(s[i + 1])) as u8);
        i += 2;
    }
    return px[..];
}

fn from_hex(w: i32, h: i32, s: u8[:]) -> image::Image {
    return image::Image { width: w, height: h, pixels: bytes_of(s), icc: [], exif: [] };
}

// sof_at gives the byte at the offset from the start of the SOF marker, or
// 0 when the bytes hold no SOF marker. The offset 1 is the marker type.
fn sof_at(b: u8[:], off: i64) -> i64 {
    var i: i64 = 2;
    while i + 4 < b.len {
        if b[i] != 255 { return 0; }
        let m = b[i + 1];
        if m == 0xc0 || m == 0xc2 {
            if i + off < b.len { return b[i + off]; }
            return 0;
        }
        let hi: i64 = b[i + 2];
        i += 2 + hi * 256 + b[i + 3];
    }
    return 0;
}

// gap gives the largest and the mean difference between the RGBA pixels and
// the RGB string. The mean is times 1000. It gives -1, -1 for a bad size.
fn gap(img: image::Image&, w: i32, h: i32, rgb: u8[:]) -> i64, i64 {
    if img.width != w || img.height != h { return -1, -1; }
    let want = bytes_of(rgb);
    var worst: i64 = 0;
    var sum: i64 = 0;
    var i: i64 = 0;
    while i < w * h {
        for c in 0..3 {
            var d: i64 = img.pixels[i * 4 + c] as i64 - want[i * 3 + c];
            if d < 0 { d = -d; }
            if d > worst { worst = d; }
            sum += d;
        }
        i += 1;
    }
    return worst, sum * 1000 / (w * h * 3);
}

// jpeg_case encodes the source, checks the marker and the sampling bytes
// that Pillow reports, and checks the pixels that Pillow decoded.
fn jpeg_case(w: i32, h: i32, src: u8[:], q: i32, prog: bool, sub: i32,
    sof: i64, samp: i64, want: u8[:]) {
    let img = from_hex(w, h, src);
    let bytes = image::encode_jpeg(img, q, prog, sub);
    assert(bytes.len > 4);
    assert(bytes[0] == 0xff && bytes[1] == 0xd8);
    assert(bytes[bytes.len - 2] == 0xff && bytes[bytes.len - 1] == 0xd9);
    assert(sof_at(bytes, 1) == sof);
    assert(sof_at(bytes, 11) == samp);
    let back = image::decode(bytes);
    // The decoder of the package (stb) upsamples the 4:2:2 chroma with a
    // different filter than libjpeg: on a 4:2:2 file that Pillow itself wrote,
    // the two decoders differ by up to 23 levels. So 4:2:2 gets a loose bound.
    let worst, mean = gap(back, w, h, want);
    assert(worst >= 0);
    if sub == 0 { assert(worst <= 8); }
    if sub == 2 { assert(worst <= 12); }
    if sub == 1 { assert(worst <= 110 && mean <= 2500); }
    // The two forms hold the same coefficients, so the pixels are the same.
    let other = image::decode(image::encode_jpeg(img, q, !prog, sub));
    assert(back.pixels == other.pixels);
    let meta = image::metadata_bytes(bytes);
    assert(meta.ok && meta.width == w && meta.height == h && meta.kind == image::KIND_JPEG);
    // The tables of the scan give a smaller file with the same pixels.
    let opt = image::encode_jpeg_opts(img, q, prog, sub, true);
    assert(opt.len > 4);
    assert(opt.len <= bytes.len);
    assert(sof_at(opt, 1) == sof);
    assert(sof_at(opt, 11) == samp);
    let oback = image::decode(opt);
    assert(oback.pixels == back.pixels);
    let ometa = image::metadata_bytes(opt);
    assert(ometa.ok && ometa.width == w && ometa.height == h && ometa.kind == image::KIND_JPEG);
}

fn check_jpeg() {
    jpeg_case(1, 1, "0ac85aff", 90, false, 0, 192, 17, "0ac85a");
    jpeg_case(1, 1, "0ac85aff", 90, true, 0, 194, 17, "0ac85a");
    jpeg_case(1, 1, "0ac85aff", 50, false, 1, 192, 33, "0dc95b");
    jpeg_case(1, 1, "0ac85aff", 50, true, 1, 194, 33, "0dc95b");
    jpeg_case(1, 1, "0ac85aff", 100, false, 2, 192, 34, "0ac85a");
    jpeg_case(1, 1, "0ac85aff", 100, true, 2, 194, 34, "0ac85a");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 50, false, 0, 192, 17, "0700002603074f070a7c0103a70000d40500f009000d31052e3b10593d15833810b1360ddc3b11f93e1109790029800b558414807d14ac7a17d97e21f6812404bd0025c60651c8147cc119a8bd20d6c22ff2c33706f20027fb0953fc197ff622acf22fdaf63ff8f84a");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 50, true, 0, 194, 17, "0700002603074f070a7c0103a70000d40500f009000d31052e3b10593d15833810b1360ddc3b11f93e1109790029800b558414807d14ac7a17d97e21f6812404bd0025c60651c8147cc119a8bd20d6c22ff2c33706f20027fb0953fc197ff622acf22fdaf63ff8f84a");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 100, false, 1, 192, 33, "0e00002a0001540000800001a90100cf0101f305030f39002b3f02543f06803f09a93f0bd1410ff444150e78002a7f06547f0c7e8013a98017cf811ff385260eb8002abf0b55c0127ebf1baabf24d1c12ef4c5390ef9002aff0c55ff1880ff24aaff2fd1ff3df4ff49");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 100, true, 1, 194, 33, "0e00002a0001540000800001a90100cf0101f305030f39002b3f02543f06803f09a93f0bd1410ff444150e78002a7f06547f0c7e8013a98017cf811ff385260eb8002abf0b55c0127ebf1baabf24d1c12ef4c5390ef9002aff0c55ff1880ff24aaff2fd1ff3df4ff49");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 10, false, 2, 192, 34, "0723001425002c2a004a2f006e3300903800b038001a40002641003e46005d4b00814f00a25402c3540f366f004372005b76007a7c019e8012bf841ede852b50a1005ca40273a90d92ae1bb6b22ad9b638f8b7435bcb0768cd0d80d2189ed726c2db35e4df43ffe04e");
    jpeg_case(7, 5, "000000ff2a0000ff550000ff7f0000ffaa0000ffd40000ffff0000ff003f00ff2a3f03ff553f06ff7f3f09ffaa3f0cffd43f0fffff3f12ff007f00ff2a7f06ff557f0cff7f7f12ffaa7f18ffd47f1effff7f24ff00bf00ff2abf09ff55bf12ff7fbf1bffaabf24ffd4bf2dffffbf36ff00ff00ff2aff0cff55ff18ff7fff24ffaaff30ffd4ff3cffffff48ff", 10, true, 2, 194, 34, "0723001425002c2a004a2f006e3300903800b038001a40002641003e46005d4b00814f00a25402c3540f366f004372005b76007a7c019e8012bf841ede852b50a1005ca40273a90d92ae1bb6b22ad9b638f8b7435bcb0768cd0d80d2189ed726c2db35e4df43ffe04e");
    jpeg_case(8, 8, "", 100, false, 0, 192, 17, "");
