    jpeg_case(16, 16, "", 90, false, 2, 192, 34, "");
    jpeg_case(16, 16, "", 90, true, 2, 194, 34, "");
    jpeg_case(17, 9, "", 75, false, 0, 192, 17, "");
    jpeg_case(17, 9, "", 75, true, 0, 194, 17, "");
    jpeg_case(17, 9, "", 90, false, 1, 192, 33, "");
    jpeg_case(17, 9, "", 90, true, 1, 194, 33, "");
    jpeg_case(17, 9, "", 50, false, 2, 192, 34, "");
    jpeg_case(17, 9, "", 50, true, 2, 194, 34, "");
    jpeg_case(40, 16, "", 90, false, 0, 192, 17, "");
    jpeg_case(40, 16, "", 90, true, 0, 194, 17, "");
    jpeg_case(40, 16, "", 50, false, 1, 192, 33, "");
    jpeg_case(40, 16, "", 50, true, 1, 194, 33, "");
    jpeg_case(40, 16, "", 100, false, 2, 192, 34, "");
    jpeg_case(40, 16, "", 100, true, 2, 194, 34, "");
    jpeg_case(24, 20, "", 50, false, 0, 192, 17, "");
    jpeg_case(24, 20, "", 50, true, 0, 194, 17, "");
    jpeg_case(24, 20, "", 100, false, 1, 192, 33, "");
    jpeg_case(24, 20, "", 100, true, 1, 194, 33, "");
    jpeg_case(24, 20, "", 10, false, 2, 192, 34, "");
    jpeg_case(24, 20, "", 10, true, 2, 194, 34, "");
    jpeg_case(33, 31, "", 100, false, 0, 192, 17, "");
    jpeg_case(33, 31, "", 100, true, 0, 194, 17, "");
    jpeg_case(33, 31, "", 10, false, 1, 192, 33, "");
    jpeg_case(33, 31, "", 10, true, 1, 194, 33, "");
    jpeg_case(33, 31, "", 75, false, 2, 192, 34, "");
    jpeg_case(33, 31, "", 75, true, 2, 194, 34, "");
    jpeg_case(200, 9, "", 10, false, 0, 192, 17, "");
    jpeg_case(200, 9, "", 10, true, 0, 194, 17, "");
