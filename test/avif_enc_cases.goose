// Generated by test/make_avif_enc_cases.py. Do not edit by hand.
// The cases come from Pillow 12.3.0.

namespace avif_enc_cases;

import std;
import image from "..";

fn hexval(c: u8) -> i64 {
    if c >= 97 { return c - 87; }
    return c - 48;
}

fn from_hex(s: u8[:]) -> u8[] {
    var px: u8[>..] = [];
    var i = 0;
    while i + 1 < s.len {
        let v: i64 = hexval(s[i]) * 16 + hexval(s[i + 1]);
        px.push(v as u8);
        i += 2;
    }
    return px[..];
}

// find gives the index of the four bytes tag in the bytes, or -1.
fn find(b: u8[:], t: u8[:]) -> i64 {
    var i = 0;
    while i + 4 <= b.len {
        if b[i] == t[0] && b[i + 1] == t[1] && b[i + 2] == t[2] && b[i + 3] == t[3] { return i; }
        i += 1;
    }
    return -1;
}

fn be32(b: u8[:], at: i64) -> i64 {
    return (b[at] as i64 << 24) | (b[at + 1] as i64 << 16) | (b[at + 2] as i64 << 8) | b[at + 3];
}

// avif_case encodes the pixels and checks the layout of the file: the ftyp
// brand, the size in ispe, the alpha item and the mdat. It writes the file
// for the Pillow check of the script.
fn avif_case(n: i32, file: u8[:], w: i32, h: i32, q: i32, speed: i32, alpha: bool, want: u8[:]) {
    let img = image::Image { width: w, height: h, pixels: from_hex(want), icc: [], exif: [] };
    let out = image::encode_avif(img, q, speed);
    assert(out.len > 64);
    assert(be32(out, 0) == 28 || be32(out, 0) == 32);
    assert(find(out, "ftyp") == 4 && find(out, "avif") == 8);
    let at = find(out, "ispe");
    assert(at > 0 && be32(out, at + 8) == w && be32(out, at + 12) == h);
    assert((find(out, "auxC") > 0) == alpha);
    assert((find(out, "auxl") > 0) == alpha);
    assert(find(out, "mdat") > 0);
    // The same bytes come out of a second encode.
    assert(image::encode_avif(img, q, speed) == out);
    assert(image::write_avif_with(file, img, q, speed));
}

