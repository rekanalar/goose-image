// Generated by test/make_gif_cases.py. Do not edit by hand.
// The cases come from Pillow 12.3.0.

namespace gif_cases;

import std;
import image from "..";

fn hexval(c: u8) -> i64 {
    if c >= 97 { return c - 87; }
    return c - 48;
}

fn from_hex(s: u8[:]) -> u8[] {
    var b: u8[>..] = [];
    var i = 0;
    while i + 1 < s.len {
        let v: i64 = hexval(s[i]) * 16 + hexval(s[i + 1]);
        b.push(v as u8);
        i += 2;
    }
    return b[..];
}

fn gif_case(file: u8[:], n: i64, gw: i32, gh: i32, loops: i32) {
    let g = image::decode_gif(from_hex(file));
    assert(g.frames.len == n);
    assert(g.width == gw && g.height == gh);
    assert(g.loop_count == loops);
}

// frame_at gives a copy of frame i. Frames cannot be indexed.
fn frame_at(g: image::Gif&, i: i64) -> image::GifFrame {
    var k = 0;
    for f in g.frames {
        if k == i { return copy(f); }
        k += 1;
    }
    assert(false);
    let e = image::Image { width: 0, height: 0, pixels: [], icc: [], exif: [] };
    return image::GifFrame { image: e, delay: 0, disposal: 0 };
}

fn frame_case(file: u8[:], i: i64, delay: i32, disp: i32, want: u8[:]) {
    let g = image::decode_gif(from_hex(file));
    let f = frame_at(g, i);
    assert(f.delay == delay);
    assert(f.disposal == disp);
    assert(f.image.width == g.width);
    assert(f.image.height == g.height);
    // An empty string means that the pixels are checked elsewhere.
    assert(want.len == 0 || f.image.pixels == from_hex(want));
}

// gif_quant_case writes the image as a GIF and reads it back. The mean
// error of the colors must stay under the bound. The clear pixels of the
// source do not count.
fn gif_quant_case(w: i32, h: i32, src: u8[:], bound: i64) {
    let want = from_hex(src);
    let img = image::Image { width: w, height: h, pixels: copy(want), icc: [], exif: [] };
    var fs: image::GifFrame[>..] = [];
    fs.push(image::GifFrame { image: copy(img), delay: 0, disposal: 0 });
    let g = image::Gif { frames: copy(fs), width: w, height: h, loop_count: 0 };
    let bytes = image::encode_gif(g);
    assert(bytes.len > 0);
    let back = image::decode_gif(bytes);
    assert(back.frames.len == 1);
    let fr = frame_at(back, 0);
    let got = fr.image.pixels;
    var sum: i64 = 0;
    var n: i64 = 0;
    var i: i64 = 0;
    while i < w * h {
        if want[i * 4 + 3] >= 128 {
            for c in 0..3 {
                var d = got[i * 4 + c] as i64 - want[i * 4 + c] as i64;
                if d < 0 { d = -d; }
                sum += d;
                n += 1;
            }
        }
        i += 1;
    }
    assert(n > 0);
    assert(sum * 1000 / n <= bound);
}

// gif_anim_case writes the frames as a GIF and reads them back. The mean
// error of the colors of every frame must stay under the bound. The
// frames follow each other in the bytes.
fn gif_anim_case(w: i32, h: i32, n: i64, src: u8[:], bound: i64) {
    let want = from_hex(src);
    var fs: image::GifFrame[>..] = [];
    var k = 0;
    while k < n {
        var px: u8[>..] = [];
        px.append(want[k * w * h * 4..(k + 1) * w * h * 4]);
        let img = image::Image { width: w, height: h, pixels: px[..], icc: [], exif: [] };
        fs.push(image::GifFrame { image: copy(img), delay: 10, disposal: 0 });
        k += 1;
    }
    let g = image::Gif { frames: copy(fs), width: w, height: h, loop_count: 0 };
    let bytes = image::encode_gif(g);
    assert(bytes.len > 0);
    let back = image::decode_gif(bytes);
    assert(back.frames.len == n);
    var f = 0;
    while f < n {
        let fr = frame_at(back, f);
        let got = fr.image.pixels;
        assert(fr.delay == 10);
        var sum: i64 = 0;
        var cnt: i64 = 0;
        var i: i64 = 0;
        while i < w * h {
            if want[(f * w * h + i) * 4 + 3] >= 128 {
                for c in 0..3 {
                    var d = got[i * 4 + c] as i64 - want[(f * w * h + i) * 4 + c] as i64;
                    if d < 0 { d = -d; }
                    sum += d;
                    cnt += 1;
                }
            }
            i += 1;
        }
        assert(cnt > 0);
        assert(sum * 1000 / cnt <= bound);
        f += 1;
    }
}

